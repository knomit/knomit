# Go build output. `go build ./tools/<name>` drops the binary in the repo root
# named after its directory, so each tool needs an entry here — one such binary
# is ~25 MB and is trivially committed by a `git add -A`.
/knomit
/knomit-bridge
/knomit-okf
/knomit-desktop
/okf
/bridge
/dist/
dist/lib/

# Claude Code — ignore everything under .claude except skills and settings.json
.claude/*
!.claude/skills/
!.claude/settings.json
.superpowers/

# Vite cache
web/.vite/

# Large test assets
internal/embeddings/testdata/*.onnx

