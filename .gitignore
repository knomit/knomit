.vscode/

# Finder (MacOS) folder config
.DS_Store

# local plans/design docs
docs/plans

# Go build output. `go build ./tools/<name>` drops the binary in the repo root
# named after its directory, so each tool needs an entry here — one such binary
# is ~25 MB and is trivially committed by a `git add -A`.
/knomit
/knomit-bridge
/knomit-okf
/knomit-desktop
/okf
/bridge
/appcast
/dist/
dist/lib/

# Claude Code — ignore everything under .claude except skills and settings.json
.claude/*
!.claude/skills/
!.claude/settings.json
.superpowers/

# Vite cache
web/.vite/

# Desktop-only UI bundle (tools/desktop/ui). Redundant with the blanket
# `node_modules`/`dist` rules above, but spelled out because one file inside
# dist/ is deliberately TRACKED: dist/.gitkeep, without which `//go:embed
# all:dist` in tools/desktop/ui/embed.go fails to compile on a fresh checkout.
# A `!tools/desktop/ui/dist/.gitkeep` negation would NOT work — git never
# descends into an excluded directory — so the sentinel was force-added once
# (`git add -f`) and stays tracked, exactly as web/dist/.gitkeep is.
tools/desktop/ui/node_modules/
tools/desktop/ui/dist/

# Large test assets
internal/embeddings/testdata/*.onnx

# E2E test artifacts
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/.e2e-state.json
*.test
.playwright-mcp/
/desktop
# compiled tool binaries (e.g. `go build -o drone ./tools/drone`)
/drone
/calibrate
