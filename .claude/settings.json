{
  "hooks": {
    "SessionStart": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "kb claude hook session-start" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "kb claude hook post-edit" }] },
      { "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "kb claude hook post-ask" }] }
    ],
    "PreCompact": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "kb claude hook pre-compact" }] }
    ]
  },
  "permissions": {
    "allow": [
    ],
    "deny": [
      "Read(./.claude/plans/archive/**)",
      "Read(./.claude/plans/ideas/**)"
    ],
    "additionalDirectories": [
    ]
  },
  "plansDirectory": ".claude/plans"
}
